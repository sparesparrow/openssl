### Vulnerability Scanning Script
```python
# scripts/security/vulnerability-scanner.py
#!/usr/bin/env python3
"""
Comprehensive vulnerability scanning for OpenSSL dependencies.
Integrates multiple security tools for comprehensive coverage.
"""

import argparse
import json
import subprocess
import sys
from pathlib import Path
from typing import Dict, List, Optional
import yaml

class VulnerabilityScanner:
    """Comprehensive vulnerability scanning for dependencies."""
    
    def __init__(self, config_path: Optional[Path] = None):
        self.config = self._load_config(config_path)
        self.scan_results = {}
        
    def _load_config(self, config_path: Optional[Path]) -> Dict:
        """Load security scanning configuration."""
        if config_path and config_path.exists():
            with open(config_path, 'r') as f:
                return yaml.safe_load(f)
        return {
            'tools': {
                'safety': {'enabled': True, 'severity_threshold': 'medium'},
                'bandit': {'enabled': True, 'severity_threshold': 'medium'},
                'semgrep': {'enabled': True, 'severity_threshold': 'medium'},
                'trivy': {'enabled': True, 'severity_threshold': 'medium'}
            },
            'policies': {
                'fail_on_critical': True,
                'fail_on_high': True,
                'fail_on_medium': False,
                'fail_on_low': False
            }
        }
    
    def scan_python_dependencies(self) -> Dict:
        """Scan Python dependencies for vulnerabilities."""
        results = {
            'tool': 'safety',
            'status': 'success',
            'vulnerabilities': [],
            'summary': {}
        }
        
        try:
            # Run safety check
            result = subprocess.run([
                'safety', 'check', '--json', '--full-report'
            ], capture_output=True, text=True, check=True)
            
            vulnerabilities = json.loads(result.stdout)
            results['vulnerabilities'] = vulnerabilities
            
            # Categorize by severity
            severity_counts = {'critical': 0, 'high': 0, 'medium': 0, 'low': 0}
            for vuln in vulnerabilities:
                severity = vuln.get('severity', 'unknown').lower()
                if severity in severity_counts:
                    severity_counts[severity] += 1
            
            results['summary'] = severity_counts
            
            # Check against policies
            if self.config['policies']['fail_on_critical'] and severity_counts['critical'] > 0:
                results['status'] = 'failed'
            elif self.config['policies']['fail_on_high'] and severity_counts['high'] > 0:
                results['status'] = 'failed'
            elif self.config['policies']['fail_on_medium'] and severity_counts['medium'] > 0:
                results['status'] = 'failed'
                
        except subprocess.CalledProcessError as e:
            results['status'] = 'error'
            results['error'] = str(e)
        
        return results
    
    def scan_code_security(self) -> Dict:
        """Scan code for security issues."""
        results = {
            'tool': 'bandit',
            'status': 'success',
            'issues': [],
            'summary': {}
        }
        
        try:
            # Run bandit security scan
            result = subprocess.run([
                'bandit', '-r', '.', '-f', 'json'
            ], capture_output=True, text=True, check=True)
            
            bandit_results = json.loads(result.stdout)
            results['issues'] = bandit_results.get('results', [])
            
            # Categorize by severity
            severity_counts = {'HIGH': 0, 'MEDIUM': 0, 'LOW': 0}
            for issue in results['issues']:
                severity = issue.get('issue_severity', 'UNKNOWN')
                if severity in severity_counts:
                    severity_counts[severity] += 1
            
            results['summary'] = severity_counts
            
            # Check against policies
            if self.config['policies']['fail_on_high'] and severity_counts['HIGH'] > 0:
                results['status'] = 'failed'
            elif self.config['policies']['fail_on_medium'] and severity_counts['MEDIUM'] > 0:
                results['status'] = 'failed'
                
        except subprocess.CalledProcessError as e:
            results['status'] = 'error'
            results['error'] = str(e)
        
        return results
    
    def scan_container_security(self) -> Dict:
        """Scan container images for vulnerabilities."""
        results = {
            'tool': 'trivy',
            'status': 'success',
            'vulnerabilities': [],
            'summary': {}
        }
        
        try:
            # Run trivy container scan
            result = subprocess.run([
                'trivy', 'image', '--format', 'json', '--severity', 'CRITICAL,HIGH,MEDIUM'
            ], capture_output=True, text=True, check=True)
            
            trivy_results = json.loads(result.stdout)
            results['vulnerabilities'] = trivy_results.get('Results', [])
            
            # Categorize by severity
            severity_counts = {'CRITICAL': 0, 'HIGH': 0, 'MEDIUM': 0, 'LOW': 0}
            for result_item in results['vulnerabilities']:
                for vuln in result_item.get('Vulnerabilities', []):
                    severity = vuln.get('Severity', 'UNKNOWN')
                    if severity in severity_counts:
                        severity_counts[severity] += 1
            
            results['summary'] = severity_counts
            
            # Check against policies
            if self.config['policies']['fail_on_critical'] and severity_counts['CRITICAL'] > 0:
                results['status'] = 'failed'
            elif self.config['policies']['fail_on_high'] and severity_counts['HIGH'] > 0:
                results['status'] = 'failed'
                
        except subprocess.CalledProcessError as e:
            results['status'] = 'error'
            results['error'] = str(e)
        
        return results
    
    def run_comprehensive_scan(self) -> Dict:
        """Run comprehensive security scan."""
        scan_results = {
            'timestamp': datetime.utcnow().isoformat(),
            'overall_status': 'success',
            'scans': {}
        }
        
        # Scan Python dependencies
        if self.config['tools']['safety']['enabled']:
            scan_results['scans']['python_dependencies'] = self.scan_python_dependencies()
        
        # Scan code security
        if self.config['tools']['bandit']['enabled']:
            scan_results['scans']['code_security'] = self.scan_code_security()
        
        # Scan container security
        if self.config['tools']['trivy']['enabled']:
            scan_results['scans']['container_security'] = self.scan_container_security()
        
        # Determine overall status
        for scan_name, scan_result in scan_results['scans'].items():
            if scan_result['status'] == 'failed':
                scan_results['overall_status'] = 'failed'
                break
            elif scan_result['status'] == 'error':
                scan_results['overall_status'] = 'error'
        
        return scan_results

def main():
    """Main entry point for vulnerability scanner."""
    parser = argparse.ArgumentParser(description='Scan for security vulnerabilities')
    parser.add_argument('--config', type=Path,
                       help='Security scanning configuration file')
    parser.add_argument('--output', type=Path, default=Path('security-scan.json'),
                       help='Output scan results file')
    parser.add_argument('--format', choices=['json', 'yaml', 'text'],
                       default='json', help='Output format')
    parser.add_argument('--fail-on-vulnerabilities', action='store_true',
                       help='Exit with error code if vulnerabilities found')
    
    args = parser.parse_args()
    
    scanner = VulnerabilityScanner(args.config)
    results = scanner.run_comprehensive_scan()
    
    # Write results to file
    with open(args.output, 'w') as f:
        if args.format == 'json':
            json.dump(results, f, indent=2)
        elif args.format == 'yaml':
            yaml.dump(results, f, default_flow_style=False)
        else:
            # Text format
            f.write(f"Security Scan Results\n")
            f.write(f"Overall Status: {results['overall_status']}\n")
            for scan_name, scan_result in results['scans'].items():
                f.write(f"\n{scan_name}: {scan_result['status']}\n")
                if 'summary' in scan_result:
                    for severity, count in scan_result['summary'].items():
                        f.write(f"  {severity}: {count}\n")
    
    # Exit with appropriate code
    if args.fail_on_vulnerabilities and results['overall_status'] == 'failed':
        sys.exit(1)
    elif results['overall_status'] == 'error':
        sys.exit(2)
    else:
        sys.exit(0)

if __name__ == '__main__':
    main()
