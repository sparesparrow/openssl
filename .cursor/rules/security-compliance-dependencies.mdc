                    "version": node.get('version', ''),
                    "description": node.get('description', ''),
                    "licenses": self._extract_licenses(node),
                    "externalReferences": [
                        {
                            "type": "distribution",
                            "url": f"conan://{node.get('name', '')}/{node.get('version', '')}"
                        }
                    ],
                    "properties": [
                        {
                            "name": "conan:package_id",
                            "value": node.get('package_id', '')
                        },
                        {
