#!/usr/bin/env python3
"""
Generate Software Bill of Materials (SBOM) for OpenSSL projects.
Uses CycloneDX format for standardized dependency reporting.
"""

import argparse
import json
import subprocess
import sys
from pathlib import Path
from typing import Dict, List, Optional
from datetime import datetime
import uuid

class SBOMManager:
    """Manages SBOM generation and validation for OpenSSL projects."""
    
    def __init__(self, project_root: Path):
        self.project_root = project_root
        self.sbom_version = "1.4"
        self.cyclonedx_version = "1.4"
        
    def generate_cyclonedx_sbom(self, output_path: Path) -> Dict:
        """Generate CycloneDX format SBOM."""
        sbom = {
            "bomFormat": "CycloneDX",
            "specVersion": self.cyclonedx_version,
            "serialNumber": f"urn:uuid:{uuid.uuid4()}",
            "version": 1,
            "metadata": self._generate_metadata(),
            "components": self._collect_components(),
            "dependencies": self._collect_dependencies(),
            "vulnerabilities": self._collect_vulnerabilities()
        }
        
        # Write SBOM to file
        with open(output_path, 'w') as f:
            json.dump(sbom, f, indent=2)
        
        return sbom
    
    def _generate_metadata(self) -> Dict:
        """Generate SBOM metadata."""
        return {
            "timestamp": datetime.utcnow().isoformat() + "Z",
            "tools": [
                {
                    "vendor": "OpenSSL Tools",
                    "name": "SBOM Generator",
                    "version": "1.0.0"
                }
            ],
            "component": {
                "type": "application",
                "name": "openssl",
                "version": self._get_openssl_version(),
                "description": "OpenSSL cryptographic library",
                "licenses": [
                    {
                        "id": "OpenSSL"
                    }
                ],
                "externalReferences": [
                    {
                        "type": "website",
                        "url": "https://www.openssl.org/"
                    },
                    {
                        "type": "vcs",
                        "url": "https://github.com/openssl/openssl"
                    }
                ]
            }
        }
    
    def _collect_components(self) -> List[Dict]:
        """Collect all components and dependencies."""
        components = []
        
        # Collect Conan dependencies
        conan_components = self._collect_conan_components()
        components.extend(conan_components)
        
        # Collect Python dependencies
        python_components = self._collect_python_components()
        components.extend(python_components)
        
        # Collect system dependencies
        system_components = self._collect_system_components()
        components.extend(system_components)
        
        return components
    
    def _collect_conan_components(self) -> List[Dict]:
        """Collect Conan package components."""
