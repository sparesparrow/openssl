    - LGPL-3.0
    - GPL-2.0
    - AGPL-1.0
    - LGPL-2.1
  
  policies:
    fail_on_blocked: true
    warn_on_unknown: true
    require_license_file: true

# Security scanning tools
security_tools:
  safety:
    enabled: true
    severity_threshold: medium
    fail_on_vulnerabilities: true
  
  bandit:
    enabled: true
    severity_threshold: medium
    fail_on_issues: true
  
  semgrep:
    enabled: true
    severity_threshold: medium
    fail_on_issues: false
  
  trivy:
    enabled: true
    severity_threshold: medium
