# scripts/compliance/license-compliance.py
#!/usr/bin/env python3
"""
License compliance checking for OpenSSL dependencies.
Ensures all dependencies comply with project license policies.
"""

import argparse
import json
import subprocess
import sys
from pathlib import Path
from typing import Dict, List, Optional
import yaml

class LicenseComplianceChecker:
    """Checks license compliance for all dependencies."""
    
    def __init__(self, config_path: Optional[Path] = None):
        self.config = self._load_config(config_path)
        
    def _load_config(self, config_path: Optional[Path]) -> Dict:
        """Load license compliance configuration."""
        if config_path and config_path.exists():
            with open(config_path, 'r') as f:
                return yaml.safe_load(f)
        return {
            'allowed_licenses': [
                'MIT', 'Apache-2.0', 'BSD-3-Clause', 'BSD-2-Clause',
                'ISC', 'OpenSSL', 'Unlicense', 'Public Domain'
            ],
            'blocked_licenses': [
                'GPL-3.0', 'AGPL-3.0', 'LGPL-3.0', 'GPL-2.0',
                'AGPL-1.0', 'LGPL-2.1'
            ],
            'policies': {
                'fail_on_blocked': True,
                'warn_on_unknown': True,
                'require_license_file': True
            }
        }
    
    def check_conan_licenses(self) -> Dict:
        """Check licenses for Conan dependencies."""
        results = {
            'tool': 'conan',
            'status': 'success',
            'violations': [],
            'summary': {}
        }
        
        try:
            # Get Conan dependency information
            result = subprocess.run([
                'conan', 'graph', 'info', '.', '--format=json'
            ], capture_output=True, text=True, check=True)
            
            graph_info = json.loads(result.stdout)
            
            for node in graph_info.get('graph', {}).get('nodes', []):
                if node.get('id', '').startswith('conanfile'):
                    continue
                
                package_name = node.get('name', '')
                package_version = node.get('version', '')
                license_info = self._get_conan_license(package_name, package_version)
                
                if license_info:
                    compliance = self._check_license_compliance(license_info)
                    if not compliance['compliant']:
                        results['violations'].append({
                            'package': package_name,
                            'version': package_version,
                            'license': license_info,
                            'reason': compliance['reason']
                        })
            
            # Categorize violations
            violation_counts = {'blocked': 0, 'unknown': 0, 'missing': 0}
            for violation in results['violations']:
                if violation['license'] in self.config['blocked_licenses']:
                    violation_counts['blocked'] += 1
                elif violation['license'] == 'Unknown':
                    violation_counts['unknown'] += 1
                else:
                    violation_counts['missing'] += 1
            
            results['summary'] = violation_counts
            
            # Check against policies
            if self.config['policies']['fail_on_blocked'] and violation_counts['blocked'] > 0:
                results['status'] = 'failed'
                
        except subprocess.CalledProcessError as e:
            results['status'] = 'error'
            results['error'] = str(e)
        
        return results
    
    def check_python_licenses(self) -> Dict:
        """Check licenses for Python dependencies."""
        results = {
            'tool': 'pip-licenses',
            'status': 'success',
            'violations': [],
            'summary': {}
        }
        
        try:
            # Get Python package licenses
            result = subprocess.run([
                'pip-licenses', '--format=json'
            ], capture_output=True, text=True, check=True)
            
            packages = json.loads(result.stdout)
            
            for package in packages:
                package_name = package.get('Name', '')
                license_info = package.get('License', 'Unknown')
                
                compliance = self._check_license_compliance(license_info)
                if not compliance['compliant']:
                    results['violations'].append({
                        'package': package_name,
                        'license': license_info,
                        'reason': compliance['reason']
                    })
            
            # Categorize violations
            violation_counts = {'blocked': 0, 'unknown': 0, 'missing': 0}
            for violation in results['violations']:
                if violation['license'] in self.config['blocked_licenses']:
                    violation_counts['blocked'] += 1
                elif violation['license'] == 'Unknown':
                    violation_counts['unknown'] += 1
                else:
                    violation_counts['missing'] += 1
            
            results['summary'] = violation_counts
            
            # Check against policies
            if self.config['policies']['fail_on_blocked'] and violation_counts['blocked'] > 0:
                results['status'] = 'failed'
                
        except subprocess.CalledProcessError as e:
            results['status'] = 'error'
            results['error'] = str(e)
        
        return results
    
    def _get_conan_license(self, package_name: str, package_version: str) -> Optional[str]:
        """Get license information for Conan package."""
        try:
            # Try to get license from package info
            result = subprocess.run([
                'conan', 'inspect', f'{package_name}/{package_version}', '--format=json'
            ], capture_output=True, text=True, check=True)
            
            package_info = json.loads(result.stdout)
            return package_info.get('license', 'Unknown')
            
        except subprocess.CalledProcessError:
            return 'Unknown'
    
    def _check_license_compliance(self, license_info: str) -> Dict:
        """Check if license is compliant with policies."""
        if license_info in self.config['blocked_licenses']:
            return {
                'compliant': False,
                'reason': f'License {license_info} is in blocked list'
            }
        elif license_info in self.config['allowed_licenses']:
            return {'compliant': True, 'reason': 'License is allowed'}
        elif license_info == 'Unknown':
            return {
                'compliant': not self.config['policies']['warn_on_unknown'],
                'reason': 'License is unknown'
            }
        else:
            return {
                'compliant': False,
                'reason': f'License {license_info} is not in allowed list'
            }
    
    def generate_compliance_report(self) -> Dict:
        """Generate comprehensive compliance report."""
        report = {
            'timestamp': datetime.utcnow().isoformat(),
            'overall_status': 'success',
            'checks': {}
        }
        
        # Check Conan licenses
        report['checks']['conan_licenses'] = self.check_conan_licenses()
        
        # Check Python licenses
        report['checks']['python_licenses'] = self.check_python_licenses()
        
        # Determine overall status
        for check_name, check_result in report['checks'].items():
            if check_result['status'] == 'failed':
                report['overall_status'] = 'failed'
                break
            elif check_result['status'] == 'error':
                report['overall_status'] = 'error'
        
        return report

def main():
    """Main entry point for license compliance checker."""
    parser = argparse.ArgumentParser(description='Check license compliance')
    parser.add_argument('--config', type=Path,
                       help='License compliance configuration file')
    parser.add_argument('--output', type=Path, default=Path('license-compliance.json'),
                       help='Output compliance report file')
    parser.add_argument('--format', choices=['json', 'yaml', 'text'],
                       default='json', help='Output format')
    parser.add_argument('--fail-on-violations', action='store_true',
                       help='Exit with error code if violations found')
    
    args = parser.parse_args()
    
    checker = LicenseComplianceChecker(args.config)
    report = checker.generate_compliance_report()
    
    # Write report to file
    with open(args.output, 'w') as f:
        if args.format == 'json':
            json.dump(report, f, indent=2)
        elif args.format == 'yaml':
            yaml.dump(report, f, default_flow_style=False)
        else:
            # Text format
            f.write(f"License Compliance Report\n")
            f.write(f"Overall Status: {report['overall_status']}\n")
            for check_name, check_result in report['checks'].items():
                f.write(f"\n{check_name}: {check_result['status']}\n")
                if 'summary' in check_result:
                    for category, count in check_result['summary'].items():
                        f.write(f"  {category}: {count}\n")
    
    # Exit with appropriate code
    if args.fail_on_violations and report['overall_status'] == 'failed':
        sys.exit(1)
    elif report['overall_status'] == 'error':
        sys.exit(2)
    else:
        sys.exit(0)

if __name__ == '__main__':
    main()
