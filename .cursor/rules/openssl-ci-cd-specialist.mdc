## Common Patterns and Solutions

### Component-Based Packaging Pattern
```python
def package_info(self):
    # CPS-ready component structure following Diego's CppCon 2024 example
    self.cpp_info.set_property("cmake_file_name", "OpenSSL")

    # Define components for libssl/libcrypto separation
    self.cpp_info.components["crypto"].libs = ["crypto"]
    self.cpp_info.components["crypto"].set_property("cmake_target_name", "OpenSSL::Crypto")

    self.cpp_info.components["ssl"].libs = ["ssl"]
    self.cpp_info.components["ssl"].set_property("cmake_target_name", "OpenSSL::SSL")
    self.cpp_info.components["ssl"].requires = ["crypto"]

    # Generate CPS file for modern build system interoperability
    self._generate_cps_file()
```

### CPS File Generation Pattern
```python
def _generate_cps_file(self):
    """Generate Common Package Specification file"""
    cps_data = {
        "cps_version": "0.13.0",
        "name": self.name,
        "version": self.version,
        "components": {
            "crypto": {
                "type": "library",
                "location": "@prefix@/lib/libcrypto.a",
                "includes": ["@prefix@/include"]
            },
            "ssl": {
                "type": "library",
                "location": "@prefix@/lib/libssl.a",
                "includes": ["@prefix@/include"],
                "requires": ["crypto"]
            }
        },
        "properties": {
            "cmake_find_module_name": "OpenSSL",
            "cmake_target:crypto": "OpenSSL::Crypto",
            "cmake_target:ssl": "OpenSSL::SSL"
        }
    }

    with open(f'{self.name}.cps', 'w') as f:
        json.dump(cps_data, f, indent=2)
```

### Python Configure Integration Pattern
```python
def generate(self):
    # Use Python configure script instead of Perl Configure
    configure_cmd = "python3 configure.py"
    configure_args = ["linux-x86_64", "--prefix=/usr/local/ssl"]

    if self.options.shared:
        configure_args.append("shared")
    else:
        configure_args.append("no-shared")

    self.run(f"{configure_cmd} {' '.join(configure_args)}", cwd=self.source_folder)

    # Generate CMake toolchain
    tc = CMakeToolchain(self)
    tc.variables["OPENSSL_ROOT_DIR"] = "/usr/local/ssl"
    tc.generate()

    deps = CMakeDeps(self)
    deps.generate()
```

