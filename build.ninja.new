
# Generated by Configure from Configurations/build.ninja.tmpl
# OpenSSL Ninja build file

# Basic variables
CC = gcc
AR = ar
RANLIB = ranlib

# Flags
CFLAGS = -Wall -O3 -DPEDANTIC -pedantic -Wno-long-long -DUNUSEDRESULT_DEBUG -Wall -Wmissing-declarations -Wextra -Wno-unused-parameter -Wno-missing-field-initializers -Wno-unterminated-string-initialization -Wswitch -Wsign-compare -Wshadow -Wformat -Wno-type-limits -Wundef -Werror -Wmissing-prototypes -Wstrict-prototypes
CPPFLAGS = 
LDFLAGS = 
LDLIBS = 

# Build rules
rule compile_c
  command = $CC -MMD -MT $out -MF $out.d $CFLAGS $CPPFLAGS -c $in -o $out
  description = CC $out
  depfile = $out.d
  deps = gcc

rule link_exe
  command = $CC $LDFLAGS $in -o $out $LDLIBS
  description = LINK $out

rule link_lib
  command = $AR rcs $out $in
  description = AR $out

# Basic targets
build libcrypto.a: link_lib
  description = Building libcrypto

build libssl.a: link_lib
  description = Building libssl

build apps/openssl: link_exe
  description = Building openssl

# Default target
default libcrypto.a libssl.a apps/openssl

# Install target
build install: phony
  command = echo "Install target - use make install for full installation"
  description = Installing OpenSSL

# Test target
build test: phony
  command = echo "Test target - use make test for full testing"
  description = Running OpenSSL tests

# Clean target
build clean: phony
  command = rm -rf *.o *.obj *.d *.so *.dll *.dylib *.a *.lib apps test fuzz providers crypto ssl include
  description = Cleaning build files